/*
|--------------------------------------------------------------------------
| CREATE NEW ADMIN
|--------------------------------------------------------------------------
*/

router.post('/newadmin', middleware, async (req, res) => {

    try {

        const exist = await adminsmodel.findById(req.userid);

        if (!exist) {
            return res.status(400).json({
                message: 'Admin not found'
            });
        }

        const {
            username,
            password
        } = req.body;

        if (!username || !password) {
            return res.status(400).json({
                message: 'Username and password are required'
            });
        }

        const user = await adminsmodel.findOne({
            username
        });

        if (user) {
            return res.status(400).json({
                message: 'Admin already exists'
            });
        }

        const hashedpassword = await bcrypt.hash(
            password,
            10
        );

        const newadmin = new adminsmodel({
            username,
            password: hashedpassword
        });

        await newadmin.save();

        return res.status(200).json({
            message: 'Admin added successfully'
        });

    } catch (err) {

        console.error('New admin error:', err);

        return res.status(500).json({
            message: 'Internal server error'
        });
    }
});


/*
|--------------------------------------------------------------------------
| FACULTY REGISTRATION
|--------------------------------------------------------------------------
| Faculty accounts are created directly without OTP in the
| original project, so that behavior is preserved.
|--------------------------------------------------------------------------
*/

router.post('/facultyregister', async (req, res) => {

    try {

        const {
            username,
            email,
            password,
            confirmpassword
        } = req.body;

        if (!username || !email || !password || !confirmpassword) {
            return res.status(400).json({
                message: 'Please fill all fields'
            });
        }

        /*
        IITGN email check
        */
        if (!isIITGNEmail(email)) {
            return res.status(400).json({
                message: 'Please use your IIT Gandhinagar email address (@iitgn.ac.in)'
            });
        }

        /*
        Password check
        */
        if (password !== confirmpassword) {
            return res.status(400).json({
                message: "Passwords don't match"
            });
        }

        /*
        Check username
        */
        const faculty = await facultymodel.findOne({
            username
        });

        const facultyverification = await otpmodel.findOne({
            username
        });

        if (faculty || facultyverification) {
            return res.status(400).json({
                message: 'Username already exists'
            });
        }

        /*
        Check email
        */
        const facultywithemail = await facultymodel.findOne({
            email: email.toLowerCase().trim()
        });

        const facultyonverificationwithemail =
            await otpmodel.findOne({
                email: email.toLowerCase().trim()
            });

        if (
            facultywithemail ||
            facultyonverificationwithemail
        ) {
            return res.status(400).json({
                message: 'Email already exists'
            });
        }

        /*
        Hash faculty password
        */
        const hashedPassword = await bcrypt.hash(
            password,
            10
        );

        /*
        Create faculty account
        */
        const newFaculty = new facultymodel({
            username,
            email: email.toLowerCase().trim(),
            password: hashedPassword
        });

        await newFaculty.save();

        return res.status(200).json({
            message: 'Faculty account created successfully'
        });

    } catch (err) {

        console.error('Faculty registration error:', err);

        return res.status(500).json({
            message: 'Internal server error'
        });
    }
});


